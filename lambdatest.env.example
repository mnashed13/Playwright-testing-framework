# Base Application Configuration
BASE_URL=https://example.com
ENVIRONMENT=staging

# LambdaTest Configuration
# Get these from: https://accounts.lambdatest.com/profile
LT_USERNAME=your_lambdatest_username
LT_ACCESS_KEY=your_lambdatest_access_key

# LambdaTest Build Configuration
LT_BUILD_NAME=Playwright Cucumber Tests
LT_TEST_NAME=Automated UI Tests

# Browser and Platform Configuration
LT_BROWSER=chrome
LT_BROWSER_VERSION=latest
LT_PLATFORM=Windows 10

# Test Execution Configuration
LT_PARALLEL=5
PARALLEL_TESTS=3

# Local Test Configuration
HEADLESS=false
SLOW_MO=100

# Test Reporting
GENERATE_REPORTS=true
UPLOAD_SCREENSHOTS=true

# Network Configuration (for LambdaTest tunnel)
LT_TUNNEL=false
LT_TUNNEL_NAME=

# Additional LambdaTest Options
LT_NETWORK_LOGS=true
LT_VIDEO=true
LT_CONSOLE_LOGS=true
LT_SELENIUM_LOGS=false

# GitHub Actions specific (set in repository secrets)
# LT_USERNAME (secret)
# LT_ACCESS_KEY (secret)
# BASE_URL (variable)
